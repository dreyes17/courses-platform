# Copy to .devcontainer/.env (git-ignored). All values are optional; see .devcontainer/README.md#environment-variables.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=courses
POSTGRES_USER=courses
POSTGRES_PASSWORD=courses
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=courses
RABBITMQ_PASSWORD=courses
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ADMIN_EMAIL=admin@courses.local
ADMIN_PASSWORD=dev-only-admin-password

# Optional MCP credentials. Only in .env — never in .mcp.json or any committed file.
GITHUB_PERSONAL_ACCESS_TOKEN=
CONTEXT7_API_KEY=
