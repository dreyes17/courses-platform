# Copy to .env (git-ignored) before `docker compose up`. These values are for local evaluation only:
# any real deployment must inject its own secrets.
POSTGRES_USER=courses
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_USER=courses
RABBITMQ_PASSWORD=change-me-rabbitmq
# HS256 signing key, at least 32 bytes.
JWT_SECRET=change-me-this-is-a-local-only-jwt-signing-secret
ADMIN_EMAIL=admin@courses.local
ADMIN_PASSWORD=change-me-admin-password
